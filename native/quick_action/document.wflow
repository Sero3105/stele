				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string># Finder Quick Action "Converti con Stele": converts the selected files and folders with the CLI
# (nothing keeps running afterwards) into "Markdown (Stele)" next to them, then shows the folder.
cd "@ROOT@" || exit 1
out="$(dirname "$1")/Markdown (Stele)"
log="$HOME/Library/Logs/Stele-azione-rapida.log"
if .venv/bin/python -m app.convert "$@" --out "$out" &gt;"$log" 2&gt;&amp;1; then
  msg="Conversione completata"
else
  msg="Alcuni file non sono stati convertiti: dettagli in ~/Library/Logs/Stele-azione-rapida.log"
fi
/usr/bin/osascript -e "display notification \"$msg\" with title \"Stele\""
[ -d "$out" ] &amp;&amp; /usr/bin/open "$out"
</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
					<string>/bin/zsh</string>
					<key>source</key>
					<string></string>
				</dict>
				<key>BundleIdentifier</key>
				<string>com.apple.RunShellScript</string>
				<key>CFBundleVersion</key>
